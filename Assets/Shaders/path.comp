#version 450
// Path tracer determinístico — a mesma cena do benchmark de CPU, corrida na GPU.
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Parametros {
    uint largura;
    uint altura;
    uint amostras;
    uint semente;
    float angulo;
} p;

layout(std430, binding = 0) buffer Saida {
    uint px[];
};

struct Esfera {
    vec3  centro;
    float raio;
    vec3  cor;
    float emissiva;
};

const int N = 6;
const Esfera ESFERAS[N] = Esfera[N](
    Esfera(vec3(-1.60, -0.35,  0.00), 0.65, vec3(0.92, 0.26, 0.28), 0.0),
    Esfera(vec3( 0.00, -0.45, -0.35), 0.55, vec3(0.25, 0.55, 0.92), 0.0),
    Esfera(vec3( 1.55, -0.30,  0.10), 0.70, vec3(0.90, 0.85, 0.75), 0.0),
    Esfera(vec3( 0.75, -0.75,  1.10), 0.25, vec3(0.95, 0.72, 0.25), 0.0),
    Esfera(vec3(-0.75, -0.78,  0.90), 0.22, vec3(0.30, 0.85, 0.55), 0.0),
    Esfera(vec3( 3.10,  1.60, -1.20), 0.90, vec3(1.00, 0.96, 0.88), 1.0)
);

uint estadoRng;

uint hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16; return x;
}

uint rngProx()
{
    estadoRng = estadoRng * 747796405u + 2891336453u;
    uint w = ((estadoRng >> ((estadoRng >> 28) + 4u)) ^ estadoRng) * 277803737u;
    return (w >> 22) ^ w;
}

float rnd() { return float(rngProx()) * (1.0 / 4294967296.0); }

float cruzaEsfera(vec3 ro, vec3 rd, vec3 c, float r)
{
    vec3 oc = ro - c;
    float b = dot(oc, rd);
    float cc = dot(oc, oc) - r * r;
    float h = b * b - cc;
    if (h < 0.0) return -1.0;
    h = sqrt(h);
    float t = -b - h;
    if (t > 0.001) return t;
    t = -b + h;
    return t > 0.001 ? t : -1.0;
}

vec3 ceu(vec3 rd)
{
    float t = 0.5 * (rd.y + 1.0);
    return mix(vec3(0.06, 0.07, 0.09), vec3(0.35, 0.42, 0.55), t);
}

vec3 traco(vec3 ro, vec3 rd)
{
    vec3 cor = vec3(0.0);
    vec3 aten = vec3(1.0);

    for (int salto = 0; salto < 3; salto++)
    {
        float tmin = 1e30;
        int id = -1;

        if (abs(rd.y) > 1e-6)
        {
            float t = (-1.0 - ro.y) / rd.y;
            if (t > 0.001 && t < tmin) { tmin = t; id = 100; }
        }
        for (int i = 0; i < N; i++)
        {
            float t = cruzaEsfera(ro, rd, ESFERAS[i].centro, ESFERAS[i].raio);
            if (t > 0.0 && t < tmin) { tmin = t; id = i; }
        }

        if (id < 0) { cor += aten * ceu(rd); break; }

        vec3 p = ro + rd * tmin;

        if (id == 100)
        {
            float xadrez = mod(floor(p.x) + floor(p.z), 2.0);
            vec3 base = mix(vec3(0.18), vec3(0.42), xadrez);
            vec3 alvo = p + vec3(0.0, 1.0, 0.0)
                      + vec3(rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0) * 0.85;
            rd = normalize(alvo - p);
            ro = p + vec3(0.0, 0.001, 0.0);
            aten *= base;
            continue;
        }

        vec3 n = normalize(p - ESFERAS[id].centro);
        if (ESFERAS[id].emissiva > 0.5)
        {
            cor += aten * ESFERAS[id].cor * 4.0;
            break;
        }

        vec3 alvo = p + n
                  + vec3(rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0) * 0.9;
        rd = normalize(alvo - p);
        ro = p + n * 0.001;
        aten *= ESFERAS[id].cor;
    }

    return cor;
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= p.largura || gid.y >= p.altura) return;

    estadoRng = hash(gid.x * 1973u + gid.y * 9277u + p.semente * 26699u);

    vec3 acc = vec3(0.0);
    float aspeto = float(p.largura) / float(p.altura);

    // Câmara: angulo == 0 mantém a imagem original do benchmark; caso contrário orbita a cena.
    bool orbitar = p.angulo != 0.0;
    vec3 ro = vec3(0.0, 0.35, -3.2);
    vec3 frente = vec3(0.0), direita = vec3(0.0), cima = vec3(0.0);
    if (orbitar)
    {
        vec3 alvo = vec3(0.0, -0.15, 0.0);
        ro = vec3(sin(p.angulo) * 3.2, 0.35 + 0.25 * sin(p.angulo * 0.5), -cos(p.angulo) * 3.2);
        frente = normalize(alvo - ro);
        direita = normalize(cross(vec3(0.0, 1.0, 0.0), frente));
        cima = cross(frente, direita);
    }

    for (uint s = 0u; s < p.amostras; s++)
    {
        vec2 uv = (vec2(gid) + vec2(rnd(), rnd())) / vec2(p.largura, p.altura) * 2.0 - 1.0;
        uv.y = -uv.y;            // linha 0 é o topo da imagem
        uv.x *= aspeto;
        vec3 rd = orbitar ? normalize(uv.x * direita + uv.y * cima + 1.7 * frente)
                          : normalize(vec3(uv, 1.7));
        acc += traco(ro, rd);
    }

    acc /= float(p.amostras);
    acc = pow(clamp(acc, vec3(0.0), vec3(1.0)), vec3(1.0 / 2.2));

    uvec3 c = uvec3(acc * 255.0 + 0.5);
    px[gid.y * p.largura + gid.x] = c.r | (c.g << 8) | (c.b << 16) | (255u << 24);
}
