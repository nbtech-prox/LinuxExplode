#version 460
// Path tracer com travessia de BVH por hardware (VK_KHR_ray_query).
// As esferas são geometria de triângulos real (icosesferas) dentro de um BLAS;
// a interseção é feita pelas unidades de RT, não à mão.
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Parametros {
    uint largura;
    uint altura;
    uint amostras;
    uint semente;
    uint total;
    uint trisPorEsfera;
    float angulo;
} p;

layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(std430, binding = 1) buffer Saida { uint px[]; };
// dados[2i] = (centro, raio) · dados[2i+1] = (cor, emissiva)
layout(std430, binding = 2) readonly buffer Lista { vec4 dados[]; };

uint estadoRng;

uint hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16; return x;
}

uint rngProx()
{
    estadoRng = estadoRng * 747796405u + 2891336453u;
    uint w = ((estadoRng >> ((estadoRng >> 28) + 4u)) ^ estadoRng) * 277803737u;
    return (w >> 22) ^ w;
}

float rnd() { return float(rngProx()) * (1.0 / 4294967296.0); }

vec3 ceu(vec3 rd)
{
    float t = 0.5 * (rd.y + 1.0);
    return mix(vec3(0.06, 0.07, 0.09), vec3(0.35, 0.42, 0.55), t);
}

struct Acerto { float t; int id; };

// Uma consulta ao BVH por raio: confirma os candidatos e fica com o mais próximo.
Acerto tracaBvh(vec3 ro, vec3 rd, float tMax)
{
    Acerto a;
    a.t = tMax;
    a.id = -1;

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, ro, 0.001, rd, tMax);

    while (rayQueryProceedEXT(rq))
    {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionEXT)
            rayQueryConfirmIntersectionEXT(rq);
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        float t = rayQueryGetIntersectionTEXT(rq, true);
        if (t > 0.0 && t < a.t)
        {
            a.t = t;
            a.id = int(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)) / int(p.trisPorEsfera);
        }
    }
    return a;
}

float cruzaPlano(vec3 ro, vec3 rd)
{
    if (abs(rd.y) < 1e-6) return -1.0;
    float t = (-1.0 - ro.y) / rd.y;
    return t > 0.001 ? t : -1.0;
}

vec3 traco(vec3 ro, vec3 rd)
{
    vec3 cor = vec3(0.0);
    vec3 aten = vec3(1.0);

    for (int salto = 0; salto < 3; salto++)
    {
        float tPlano = cruzaPlano(ro, rd);
        float limite = tPlano > 0.0 ? tPlano : 1e6;

        Acerto a = tracaBvh(ro, rd, limite);

        bool acertouEsfera = a.id >= 0 && a.id < int(p.total);
        bool acertouPlano = tPlano > 0.0 && (!acertouEsfera || tPlano < a.t);

        if (!acertouEsfera && !acertouPlano) { cor += aten * ceu(rd); break; }

        if (acertouPlano)
        {
            vec3 pp = ro + rd * tPlano;
            float xadrez = mod(floor(pp.x) + floor(pp.z), 2.0);
            vec3 base = mix(vec3(0.18), vec3(0.42), xadrez);
            vec3 alvo = pp + vec3(0.0, 1.0, 0.0)
                      + vec3(rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0) * 0.85;
            rd = normalize(alvo - pp);
            ro = pp + vec3(0.0, 0.001, 0.0);
            aten *= base;
            continue;
        }

        vec3 pe = ro + rd * a.t;
        vec3 centro = dados[2 * a.id].xyz;
        vec3 n = normalize(pe - centro);

        if (dados[2 * a.id + 1].w > 0.5)
        {
            cor += aten * dados[2 * a.id + 1].xyz * 4.0;
            break;
        }

        vec3 alvo = pe + n
                  + vec3(rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0, rnd() * 2.0 - 1.0) * 0.9;
        rd = normalize(alvo - pe);
        ro = pe + n * 0.001;
        aten *= dados[2 * a.id + 1].xyz;
    }

    return cor;
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= p.largura || gid.y >= p.altura) return;

    estadoRng = hash(gid.x * 1973u + gid.y * 9277u + p.semente * 26699u);

    vec3 acc = vec3(0.0);
    float aspeto = float(p.largura) / float(p.altura);

    // Câmara: angulo == 0 mantém a imagem original do benchmark; caso contrário orbita a cena.
    bool orbitar = p.angulo != 0.0;
    vec3 ro = vec3(0.0, 0.35, -3.2);
    vec3 frente = vec3(0.0), direita = vec3(0.0), cima = vec3(0.0);
    if (orbitar)
    {
        vec3 alvo = vec3(0.0, -0.15, 0.0);
        ro = vec3(sin(p.angulo) * 3.2, 0.35 + 0.25 * sin(p.angulo * 0.5), -cos(p.angulo) * 3.2);
        frente = normalize(alvo - ro);
        direita = normalize(cross(vec3(0.0, 1.0, 0.0), frente));
        cima = cross(frente, direita);
    }

    for (uint s = 0u; s < p.amostras; s++)
    {
        vec2 uv = (vec2(gid) + vec2(rnd(), rnd())) / vec2(p.largura, p.altura) * 2.0 - 1.0;
        uv.y = -uv.y;
        uv.x *= aspeto;
        vec3 rd = orbitar ? normalize(uv.x * direita + uv.y * cima + 1.7 * frente)
                          : normalize(vec3(uv, 1.7));
        acc += traco(ro, rd);
    }

    acc /= float(p.amostras);
    acc = pow(clamp(acc, vec3(0.0), vec3(1.0)), vec3(1.0 / 2.2));

    uvec3 c = uvec3(acc * 255.0 + 0.5);
    px[gid.y * p.largura + gid.x] = c.r | (c.g << 8) | (c.b << 16) | (255u << 24);
}
