<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>LinuxExplode</AssemblyName>
    <Product>LINUX EXPLODE</Product>
    <Version>0.20.11</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- O EXPLODE BENCH mede desempenho real: JIT otimizado mesmo em Debug -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Depois de correr ./empacotar.sh ficam aqui centenas de MB de artefactos (build-dir,
         .flatpak-builder, publish*) que não devem entrar nos globs `**/*.axaml` do Avalonia
         nem na enumeração de ficheiros do MSBuild — foi o que fez falhar o publish arm64 no CI
         com "Could not find file .../**/*.axaml". -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build-dir/**;.flatpak-builder/**;flatpak/staging/**;flatpak/build-arm64/**;flatpak/repo-arm64/**;publish/**;publish-arm64/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <!-- O Silk.NET.Core traz System.Text.Json/Encodings.Web 9.x; sem referência DIRECTA o
         publish self-contained copia a versão 8.0 do runtime pack e a app falha com
         "Could not load file or assembly System.Text.Json, Version=9.0.0.0". -->
    <PackageReference Include="System.Text.Json" Version="9.0.9" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.9" />
  </ItemGroup>

  <!--
    O Silk.NET.Core depende de System.Text.Json 9.x. No publish self-contained o runtime pack
    do .NET 8 repõe a versão 8.0 e a app rebenta com "Could not load file or assembly
    System.Text.Json, Version=9.0.0.0" mal toque em JSON (S.M.A.R.T.). Nem PackageConflict-
    PreferredPackages nem referência directa resolvem; copia-se o DLL do pacote no fim.
  -->
  <Target Name="CorrigirSystemTextJson" AfterTargets="Publish">
    <ItemGroup>
      <StjDoPacote Include="$(NuGetPackageRoot)system.text.json/*/lib/net8.0/System.Text.Json.dll" />
      <StjEncDoPacote Include="$(NuGetPackageRoot)system.text.encodings.web/*/lib/net8.0/System.Text.Encodings.Web.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(StjDoPacote)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(StjEncDoPacote)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets/*.png" />
    <AvaloniaResource Include="Assets/*.ico" />
    <!-- O path tracer em SPIR-V é lido como recurso binário em tempo de execução -->
    <EmbeddedResource Include="Assets/Shaders/*.spv" />
  </ItemGroup>

</Project>
