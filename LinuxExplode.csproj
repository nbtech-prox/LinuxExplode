<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>LinuxExplode</AssemblyName>
    <Product>LINUX EXPLODE</Product>
    <Version>0.20.15</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- O EXPLODE BENCH mede desempenho real: JIT otimizado mesmo em Debug -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Depois de correr ./empacotar.sh ficam aqui centenas de MB de artefactos (build-dir,
         .flatpak-builder, publish*) que não devem entrar nos globs `**/*.axaml` do Avalonia
         nem na enumeração de ficheiros do MSBuild — foi o que fez falhar o publish arm64 no CI
         com "Could not find file .../**/*.axaml". -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build-dir/**;.flatpak-builder/**;flatpak/staging/**;flatpak/build-arm64/**;flatpak/repo-arm64/**;publish/**;publish-arm64/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <!-- No .NET 10, System.Text.Json e System.Text.Encodings.Web vêm do próprio runtime
         (referência implícita); declará-los dá NU1510 e voltaria a arrastar o pacote em vez
         do framework. -->

  </ItemGroup>

  <!--
    No .NET 8 o publish self-contained repunha o System.Text.Json 8.0 do runtime pack por cima do
    9.x exigido pelo Silk.NET.Core ("Could not load file or assembly System.Text.Json,
    Version=9.0.0.0") e era preciso copiar à mão o DLL do pacote depois do Publish. No .NET 10 o
    runtime traz a 10.x, que satisfaz a dependência, e a cópia passou a ser desnecessária — e seria
    errada, porque copiava o build net8.0 do pacote por cima do runtime 10.
  -->

  <ItemGroup>
    <AvaloniaResource Include="Assets/*.png" />
    <AvaloniaResource Include="Assets/*.ico" />
    <!-- O path tracer em SPIR-V é lido como recurso binário em tempo de execução -->
    <EmbeddedResource Include="Assets/Shaders/*.spv" />
  </ItemGroup>

</Project>
