{
  "app-id": "pt.linuxexplode.LinuxExplode",
  "branch": "stable",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "LinuxExplode",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--device=dri",
    "--filesystem=xdg-documents",
    "--persist=.local/share/linux-explode",
    "--filesystem=~/mangologs:ro",
    "--filesystem=~/.config/MangoHud:ro",
    "--filesystem=~/.local/share/MangoHud:ro",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.kde.StatusNotifierItem",
    "--own-name=org.kde.StatusNotifierItem-2-0",
    "--own-name=org.kde.StatusNotifierItem-2-1"
  ],
  "cleanup": [
    "/share/doc",
    "/share/man"
  ],
  "modules": [
    {
      "name": "LinuxExplode",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin/linuxexplode",
        "cp -r app/. /app/bin/linuxexplode/",
        "chmod +x /app/bin/linuxexplode/LinuxExplode",
        "ln -sf /app/bin/linuxexplode/LinuxExplode /app/bin/LinuxExplode",
        "install -Dm644 pt.linuxexplode.LinuxExplode.desktop /app/share/applications/pt.linuxexplode.LinuxExplode.desktop",
        "install -Dm644 pt.linuxexplode.LinuxExplode.metainfo.xml /app/share/metainfo/pt.linuxexplode.LinuxExplode.metainfo.xml",
        "install -Dm644 logo.png /app/share/icons/hicolor/256x256/apps/pt.linuxexplode.LinuxExplode.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "staging"
        }
      ]
    }
  ]
}
